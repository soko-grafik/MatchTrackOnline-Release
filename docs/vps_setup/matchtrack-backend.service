[Unit]
Description=MatchTrack Online FastAPI Backend (Uvicorn ASGI)
After=network.target

[Service]
User=root
WorkingDirectory=/var/www/matchtrack/backend
ExecStart=/var/www/matchtrack/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 4
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
